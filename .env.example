# PostgreSQL (runtime: pooled connection, recommended for Vercel serverless)
# Supabase example format:
# DATABASE_URL="postgresql://USER:PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?pgbouncer=true&connection_limit=1&sslmode=require"

# PostgreSQL direct connection (used by Prisma migrate/introspect)
# Supabase example format:
# DIRECT_URL="postgresql://USER:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require"

# If using Vercel Postgres integration, POSTGRES_PRISMA_URL is auto-provided.
# The app will use DATABASE_URL first, then POSTGRES_PRISMA_URL fallback.

JWT_SECRET="replace-with-a-long-random-secret"

NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_STORAGE_BUCKET="tournaments"